# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

# +---------+
# | HISTORY |
# +---------+

setopt EXTENDED_HISTORY          # Write the history file in the ':start:elapsed;command' format.
setopt SHARE_HISTORY             # Share history between all sessions.
setopt HIST_EXPIRE_DUPS_FIRST    # Expire a duplicate event first when trimming history.
setopt HIST_IGNORE_DUPS          # Do not record an event that was just recorded again.
setopt HIST_IGNORE_ALL_DUPS      # Delete an old recorded event if a new event is a duplicate.
setopt HIST_FIND_NO_DUPS         # Do not display a previously found event.
setopt HIST_IGNORE_SPACE         # Do not record an event starting with a space.
setopt HIST_SAVE_NO_DUPS         # Do not write a duplicate event to the history file.
setopt HIST_VERIFY               # Do not execute immediately upon history expansion.
setopt AUTO_CD                   # Navigate to a directory without typing 'cd'.
setopt AUTO_PUSHD                # Push the old directory onto the stack on cd.
setopt PUSHD_SILENT              # Do not print the directory stack after pushd or popd.

# +-------+
# | alias |
# +-------+

# If needs to be on a different file then
# source $HOME/.zsh_aliases

# ---- Quick dirs ----
# See stack with 'd' and go back with 'cd -2'
alias d='dirs -v'

# ---- cd ----
alias ..="cd .."

# ---- ls ----
alias l='ls -l --git'
alias la='ls -lahF'

# ---- file management ----
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -iv'

# ---- other apps ----
alias lzg='lazygit'
alias vim='nvim'
alias nas='ssh -i ~/.ssh/nas_mac -p 64100 diego@192.168.1.100'

# ---- tmux ----
# Attaches tmux to the last session; creates a new session if none exists.
alias t='tmux attach || tmux new-session'

# Attaches tmux to a session (example: ta portal)
alias ta='tmux attach -t'

# Creates a new named session
alias tn='tmux new -s'

# Lists all ongoing sessions
alias tl='tmux list-sessions'

# Kill all sessions
alias tka='tmux kill-server'

# Kill specific session
alias tk='tmux kill-session -t'

# +------------------------------------------+
# | SUFFIX ALIASES — abrir archivos con nvim |
# +------------------------------------------+

# Shells & scripts
alias -s {sh,bash,zsh,fish,ksh,csh,tcsh}=nvim

# Código
alias -s {py,rb,js,ts,go,rs,c,cpp,cc,cxx,h,hpp,java,kt,swift,lua,php,pl,r,scala,cs}=nvim

# Web
alias -s {html,htm,css,scss,sass,less,vue,jsx,tsx,svelte}=nvim

# Configs estructuradas
alias -s {json,yaml,yml,toml,xml,hcl,tfvars}=nvim

# Texto plano & docs
alias -s {txt,md,rst,org,adoc,tex,csv,tsv,log,diff,patch}=nvim

# Configs genéricas
alias -s {conf,cfg,ini,env,rc,properties,profile,prefs}=nvim

# Linux / Debian
alias -s {list,repo,sources,dpkg,rules,control,changelog,copyright,cron,anacrontab}=nvim

# Systemd
alias -s {service,timer,socket,mount,target,path,scope,slice,network,netdev,link}=nvim

# SSH & certificados
alias -s {pub,pem,key,crt,cer,csr,p12}=nvim

# Docker & contenedores
alias -s {dockerfile,containerfile,dockerignore,helmignore}=nvim

# Infra & DevOps
alias -s {tf,tfstate}=nvim
alias -s {pp}=nvim
alias -s {j2,jinja,jinja2}=nvim
alias -s {groovy,jenkinsfile}=nvim

# Versionado & editor
alias -s {gitignore,gitattributes,editorconfig}=nvim

# Bases de datos
alias -s {sql,ddl,dml,psql,sqlite}=nvim

# Build & otros
alias -s {mk,cmake,nix,desktop,pkla,makefile}=nvim

# +---------+
# | Plugins |
# +---------+

# ----- Eza (better ls) -----
alias ls="eza --icons=always"
alias lt="eza --icons=always --long --tree --level=3"

# ---- Zoxide (better cd) ----
eval "$(zoxide init zsh)"
alias cd="z"

# ---- Tidal Downloader ----
alias td="tiddl download url"

# ---- Command line fuzzy finder ----
source <(fzf --zsh)

# ---- Suggestions and Highlight ---
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

. "$HOME/.local/bin/env"

if [ -z "$SSH_AUTH_SOCK" ]; then
    eval "$(ssh-agent -s)" > /dev/null
fi
ssh-add -l | grep -q githubmac || ssh-add ~/.ssh/githubmac 2>/dev/null

export TIDDL_PATH="$HOME/.tiddl"
